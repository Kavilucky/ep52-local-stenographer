# Пример переменных окружения для контура Локальный стенографист (L02).
# Скопируйте файл в .env и заполните значения. Секретов здесь нет и быть не должно:
# все модели работают локально, ключи API не используются.

# --- Модель расшифровки (faster-whisper) ---
# small — быстрее и легче, medium — точнее и медленнее. Обе работают в int8 на CPU.
WHISPER_MODEL=small
# Устройство вычислений и тип квантизации faster-whisper.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Таймаут выгрузки модели Whisper из памяти после запроса (0 — выгружать сразу).
WHISPER_IDLE_TIMEOUT=0

# --- Локальная модель Ollama для составления протокола ---
# На 4 ГБ VRAM берите модель уровня small: qwen2.5:3b или llama3.2:3b.
OLLAMA_MODEL=qwen2.5:3b

# --- Режим работы воркера ---
# service — расшифровка идёт через HTTP-сервис faster-whisper (контейнерный сценарий).
# local  — воркер импортирует faster_whisper сам и считает в том же процессе.
ASR_BACKEND=service

# --- Вход и выход ---
# Каталог с исходными записями (подключается в контейнер только на чтение).
AUDIO_DIR=./audio
# Имя файла записи внутри AUDIO_DIR.
AUDIO_FILE=meeting.wav
# Каталог, куда складываются transcript.txt и protocol.md.
OUTPUT_DIR=./out
